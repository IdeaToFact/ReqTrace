<?xml version="1.0" encoding="UTF-8"?>
<REQ-IF xmlns="http://www.omg.org/spec/ReqIF/20110401/reqif.xsd">
  <CORE-CONTENT>
    <REQ-IF-CONTENT>
      <SPEC-TYPES>
        <SPEC-OBJECT-TYPE IDENTIFIER="type_avionics" LONG-NAME="Avionics Requirement">
          <SPEC-ATTRIBUTES>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="attr_id" LONG-NAME="Customer_Req_Number"/>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="attr_title" LONG-NAME="ReqIF.Name"/>
            <ATTRIBUTE-DEFINITION-XHTML IDENTIFIER="attr_text" LONG-NAME="ReqIF.Text"/>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="attr_type" LONG-NAME="Object Type"/>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="attr_level" LONG-NAME="Requirement Level"/>
          </SPEC-ATTRIBUTES>
        </SPEC-OBJECT-TYPE>
      </SPEC-TYPES>
      <SPEC-OBJECTS>
        <SPEC-OBJECT IDENTIFIER="obj_sec_01" LAST-CHANGE="2026-11-01T09:00:00Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="SEC-01">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_id</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Section 1: Flight Control and Avionics Scope">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_title</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Heading">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_type</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="System">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <THE-VALUE><div><p>Informative scope overview for Flight Control Suite Rev 2.0.</p></div></THE-VALUE>
              <DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>attr_text</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION>
            </ATTRIBUTE-VALUE-XHTML>
          </VALUES>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="obj_sys_001" LAST-CHANGE="2026-11-01T09:00:00Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="SYS-FLT-001">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_id</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Triple-Modular IMU Failover">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_title</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Requirement">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_type</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="System">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <THE-VALUE><div><p>The flight control computer <b>shall maintain triple-modular redundant attitude estimation</b> during single IMU failure.</p></div></THE-VALUE>
              <DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>attr_text</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION>
            </ATTRIBUTE-VALUE-XHTML>
          </VALUES>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="obj_nav_101" LAST-CHANGE="2026-11-10T10:00:00Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="REQ-NAV-101">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_id</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="GPS Loss Dead-Reckoning Switchover (Tightened)">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_title</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Requirement">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_type</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="High-Level">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <THE-VALUE><div><p>The navigation subsystem <b>shall switch</b> to inertial dead-reckoning within 100ms of GPS signal loss.</p></div></THE-VALUE>
              <DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>attr_text</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION>
            </ATTRIBUTE-VALUE-XHTML>
          </VALUES>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="obj_nav_102" LAST-CHANGE="2026-11-01T09:00:00Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="REQ-NAV-102">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_id</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Kalman Position Drift Ceiling">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_title</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Requirement">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_type</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="High-Level">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <THE-VALUE><div><p>Kalman filter position drift shall remain below 5.0 meters over any 60-second dead-reckoning interval.</p></div></THE-VALUE>
              <DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>attr_text</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION>
            </ATTRIBUTE-VALUE-XHTML>
          </VALUES>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="obj_pwr_201" LAST-CHANGE="2026-11-01T09:00:00Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="REQ-PWR-201">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_id</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Emergency Battery Bus Sustain">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_title</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Requirement">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_type</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Low-Level">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <THE-VALUE><div><p>Emergency backup battery shall sustain primary avionics bus voltage above 24.0V for at least 30 minutes.</p></div></THE-VALUE>
              <DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>attr_text</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION>
            </ATTRIBUTE-VALUE-XHTML>
          </VALUES>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="obj_hyd_401" LAST-CHANGE="2026-11-01T09:00:00Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="REQ-HYD-401">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_id</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Hydraulic Actuator Bypass Protection">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_title</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Requirement">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_type</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="High-Level">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <THE-VALUE><div><p>Hydraulic actuator servo loop shall detect pressure drop below 1800 PSI and engage bypass valve within 50ms.</p></div></THE-VALUE>
              <DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>attr_text</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION>
            </ATTRIBUTE-VALUE-XHTML>
          </VALUES>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="obj_sec_501" LAST-CHANGE="2026-11-10T10:00:00Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="REQ-SEC-501">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_id</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Secure Boot Signature Verification">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_title</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Requirement">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_type</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="High-Level">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <THE-VALUE><div><p>Flight software loader shall verify ECDSA P-384 image signatures before executing primary flight code.</p></div></THE-VALUE>
              <DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>attr_text</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION>
            </ATTRIBUTE-VALUE-XHTML>
          </VALUES>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="obj_orphan_900" LAST-CHANGE="2026-11-01T09:00:00Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="REQ-ORPHAN-900">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_id</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Crash Memory AES-256 Encryption">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_title</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Requirement">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_type</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Low-Level">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>attr_level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <THE-VALUE><div><p>Cockpit flight data recorder shall encrypt solid-state crash memory using AES-256-GCM at rest.</p></div></THE-VALUE>
              <DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>attr_text</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION>
            </ATTRIBUTE-VALUE-XHTML>
          </VALUES>
        </SPEC-OBJECT>
      </SPEC-OBJECTS>
